<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %> - SoftSkill Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/admin.css">
<style>body{font-family:'Outfit',sans-serif;}</style>
</head>
<body>
<div class="admin-wrapper">
    <aside class="sidebar">
        <div class="brand">
            <img src="/logo.png" alt="SoftSkill">
            <span>SoftSkill Admin</span>
        </div>
        <nav>
            <a href="/admin/dashboard" class="<%= activeNav === 'dashboard' ? 'active' : '' %>">📊 Dashboard</a>
            <a href="/admin/courses" class="<%= activeNav === 'courses' ? 'active' : '' %>">📚 Courses</a>
            <a href="/admin/certificates" class="<%= activeNav === 'certificates' ? 'active' : '' %>">🎓 Certificates</a>
            <a href="/admin/messages" class="<%= activeNav === 'messages' ? 'active' : '' %>">✉️ Contact Messages</a>
            <a href="/admin/change-password" class="<%= activeNav === 'password' ? 'active' : '' %>">🔒 Change Password</a>
            <a href="/" target="_blank">🌐 View Site</a>
        </nav>
    </aside>
    <main class="main">
        <div class="topbar">
            <h1><%= pageTitle %></h1>
            <div class="user-chip">
                <span>👤 <%= admin ? (admin.full_name || admin.username) : 'Admin' %></span>
                <a href="/admin/logout" class="logout-link">Logout</a>
            </div>
        </div>

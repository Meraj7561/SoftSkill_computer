<%- include('../partials/admin-header') %>

<% if (notice) { %>
    <div class="alert alert-<%= noticeType %>"><%= notice %></div>
<% } %>

<div class="panel">
    <h2>Upload Certificate Data (Excel / CSV)</h2>
    <p class="help-text" style="margin-top:0;">
        The file's first row must be a header row. Supported column names (any order, case-insensitive):
        <code>roll_no, student_name, course_name, duration, grade, issue_date, father_name, extra_info</code>.
        Uploading a roll number that already exists will update that record instead of duplicating it.
    </p>
    <form method="POST" action="/admin/certificates/upload" enctype="multipart/form-data" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
        <div style="flex:1; min-width:240px;">
            <label>Excel (.xlsx) or CSV file</label>
            <input type="file" name="cert_file" accept=".xlsx,.csv" required>
        </div>
        <div>
            <button type="submit" class="btn">Upload & Import</button>
        </div>
    </form>
</div>

<div class="panel">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
        <form method="GET" style="display:flex; gap:8px;">
            <input type="text" name="search" placeholder="Search by roll no or name" value="<%= search %>" style="margin-bottom:0; min-width:240px;">
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
        <a href="/admin/certificates/clear-all" class="btn btn-danger btn-sm"
           onclick="return confirm('This will delete ALL certificate records. Continue?');">Clear All Records</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Roll No</th>
                <th>Student Name</th>
                <th>Course</th>
                <th>Duration</th>
                <th>Grade</th>
                <th>Issue Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <% if (records.length === 0) { %>
            <tr><td colspan="7">No certificate records found. Upload an Excel/CSV file above.</td></tr>
        <% } else { records.forEach(function(r) { %>
            <tr>
                <td><%= r.roll_no %></td>
                <td><%= r.student_name %></td>
                <td><%= r.course_name %></td>
                <td><%= r.duration %></td>
                <td><%= r.grade %></td>
                <td><%= r.issue_date %></td>
                <td>
                    <a class="btn btn-sm btn-danger" href="/admin/certificates/delete/<%= r.id %>"
                       onclick="return confirm('Delete this record?');">Delete</a>
                </td>
            </tr>
        <% }) } %>
        </tbody>
    </table>
</div>

<%- include('../partials/admin-footer') %>

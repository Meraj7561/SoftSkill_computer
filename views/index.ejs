<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoftSkill Institute of Computer Education - Be a part of digital revolution!</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-content">
                <div class="logo-container">
                    <img src="logo.png" alt="SoftSkill Institute" class="logo-img">
                    <span class="logo-text">SoftSkill</span>
                </div>
                
                <div class="nav-links">
                    <a href="#home" class="nav-link active">Home</a>
                    <a href="#about" class="nav-link">About</a>
                    <a href="#courses" class="nav-link">Courses</a>
                    <a href="#verify" class="nav-link">Certificates</a>
                    <a href="#facilities" class="nav-link">Facilities</a>
                    <a href="#contact" class="nav-link">Contact</a>
                </div>
                
                <div class="nav-contact">
                    <span class="contact-number">+91 9852525294</span>
                </div>
                
                <div class="social-icons">
                    <a href="https://www.facebook.com/SoftskillComputer/photos/" class="social-icon facebook" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                    </a>
                    <a href="#" class="social-icon twitter" aria-label="Twitter">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                        </svg>
                    </a>
                    <a href="#" class="social-icon youtube" aria-label="YouTube">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                    </a>
                </div>
                
                <button class="mobile-menu-btn" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
        
        <div class="notification-bar">
            <div class="container">
                <div class="notification-content">
                    <span class="notification-icon">📢</span>
                    <div class="notification-scroll">
                        <span>New batch starting soon! Limited seats available • Enroll now and get 20% discount • 100% Job Assistance guaranteed</span>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-background">
            <div class="grid-pattern"></div>
            <div class="gradient-orb orb-1"></div>
            <div class="gradient-orb orb-2"></div>
            <div class="gradient-orb orb-3"></div>
        </div>
        
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="hero-title">
                        <span class="title-line">Welcome to</span>
                        <span class="title-highlight">SoftSkill </span>
                        <span class="title-line">Computer Institute</span>
                    </h1>
                    <p class="hero-subtitle">Be a part of digital revolution!</p>
                    <p class="hero-description">
                        We're thrilled to have you here. As you step into our virtual campus, you're entering a world of limitless possibilities. Discover a wide range of courses, passionate instructors, and a vibrant community dedicated to shaping the future of technology.
                    </p>
                    <div class="hero-cta">
                        <a href="#courses" class="btn btn-primary">Explore Courses</a>
                        <a href="#contact" class="btn btn-secondary">Get in Touch</a>
                    </div>
                    <div class="hero-stats">
                        <div class="stat">
                            <span class="stat-number">12+</span>
                            <span class="stat-label">Years Experience</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">100%</span>
                            <span class="stat-label">Job Assistance</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">50+</span>
                            <span class="stat-label">Courses</span>
                        </div>
                    </div>
                </div>
                
                <div class="hero-image">
                    <div class="floating-card card-1">
                        <div class="card-icon">💻</div>
                        <div class="card-text">Expert Faculty</div>
                    </div>
                    <div class="floating-card card-2">
                        <div class="card-icon">🎓</div>
                        <div class="card-text">Quality Education</div>
                    </div>
                    <div class="floating-card card-3">
                        <div class="card-icon">🚀</div>
                        <div class="card-text">Career Growth</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Facilities Section -->
    <section id="facilities" class="facilities">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Our Facilities</h2>
                <p class="section-subtitle">World-class infrastructure for the best learning experience</p>
            </div>
            
            <div class="facilities-grid">
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="facility-title">Experienced Faculties</h3>
                    <p class="facility-description">Learn from industry experts with years of practical experience</p>
                </div>
                
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <h3 class="facility-title">100% Job Assistance</h3>
                    <p class="facility-description">Guaranteed placement support to kickstart your tech career</p>
                </div>
                
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <h3 class="facility-title">Hybrid Computer Lab</h3>
                    <p class="facility-description">State-of-the-art labs with latest technology and software</p>
                </div>
                
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                            <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                            <line x1="12" y1="20" x2="12.01" y2="20"></line>
                        </svg>
                    </div>
                    <h3 class="facility-title">Free WiFi Campus</h3>
                    <p class="facility-description">High-speed internet access throughout the campus</p>
                </div>
                
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                    </div>
                    <h3 class="facility-title">CCTV Surveillance</h3>
                    <p class="facility-description">24/7 security monitoring for a safe learning environment</p>
                </div>
                
                <div class="facility-card">
                    <div class="facility-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3 class="facility-title">Flexible Timing</h3>
                    <p class="facility-description">Choose batch timings that suit your schedule</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <div class="about-content">
                <div class="about-text">
                    <h2 class="section-title">About SoftSkill</h2>
                    <p class="about-description">
                        Welcome to <strong>SoftSkill</strong>, a leading computer institute dedicated to empowering individuals with cutting-edge technology skills. We're on a mission to shape the tech leaders of tomorrow through quality education to serve the society in all possible ways.
                    </p>
                    <p class="about-description">
                        With a <strong>legacy of 12 years</strong> in tech education, we are your pathway to a successful career in the world of computers and technology. Our commitment is to provide a dynamic learning environment where students thrive in the ever-evolving tech landscape.
                    </p>
                    <p class="about-description">
                        Join a community of tech enthusiasts at SoftSkill, where knowledge knows no bounds. We offer a comprehensive range of courses designed to meet the demands of the digital age where your tech journey begins.
                    </p>
                    
                    <div class="mission-box">
                        <h3 class="mission-title">Our Mission</h3>
                        <p>To empower you with the knowledge and skills to thrive in the digital age. Explore our courses, meet our expert faculty, and embark on a transformative learning experience today.</p>
                    </div>
                </div>
                
                <div class="about-video">
                    <div class="video-placeholder">
                        <div class="play-button">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                        </div>
                        <span class="video-text">Watch Our Story</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Courses Section -->
    <section id="courses" class="courses">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Our Courses</h2>
                <p class="section-subtitle">Choose from our comprehensive range of industry-relevant programs</p>
            </div>
            
            <div class="course-categories">
                <button class="category-tab active" data-category="computer">Computer Courses</button>
                <button class="category-tab" data-category="university">University Courses</button>
                <button class="category-tab" data-category="programming">Programming</button>
                <button class="category-tab" data-category="english">Spoken English</button>
            </div>

            <!-- Computer Courses (managed from Admin Panel) -->
            <div class="course-category-content active" data-category="computer">
                <%- renderCourseCards(coursesByCategory.computer) %>
            </div>

            <!-- University Courses (managed from Admin Panel) -->
            <div class="course-category-content" data-category="university">
                <% if (!coursesByCategory.university || coursesByCategory.university.length === 0) { %>
                    <div class="university-intro">
                        <p>Coming Soon</p>
                    </div>
                <% } else { %>
                    <%- renderCourseCards(coursesByCategory.university) %>
                <% } %>
            </div>

            <!-- Programming Courses (managed from Admin Panel) -->
            <div class="course-category-content" data-category="programming">
                <%- renderCourseCards(coursesByCategory.programming) %>
            </div>

            <!-- English Courses -->
            <div class="course-category-content" data-category="english">
                <div class="english-features">
                    <div class="english-card">
                        <div class="english-icon">📚</div>
                        <h3>Basic and Advance Grammar</h3>
                        <p>Master the fundamentals and advanced concepts</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">💬</div>
                        <h3>Vocab Enrichment</h3>
                        <p>Expand your vocabulary significantly</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">🗣️</div>
                        <h3>Communication Skill</h3>
                        <p>Enhance your professional communication</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">💭</div>
                        <h3>Conversation Techniques</h3>
                        <p>Learn effective conversation strategies</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">🎤</div>
                        <h3>Pronunciation & Accent</h3>
                        <p>Improve your speaking clarity</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">👥</div>
                        <h3>Public Speaking</h3>
                        <p>Build confidence in public presentations</p>
                    </div>

                    <div class="english-card">
                        <div class="english-icon">✨</div>
                        <h3>Personality Development</h3>
                        <p>Transform your overall personality</p>
                    </div>
                </div>
                <% if (coursesByCategory.english && coursesByCategory.english.length > 0) { %>
                    <div style="margin-top: 30px;">
                        <%- renderCourseCards(coursesByCategory.english) %>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Certificate Verification Section -->
    <section id="verify" class="contact" style="padding-top: 60px;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Verify Certificate</h2>
                <p class="section-subtitle">Enter your roll number to instantly check your certificate details</p>
            </div>

            <div class="contact-form-container" style="max-width: 520px; margin: 0 auto;">
                <form id="verifyForm">
                    <div class="form-group">
                        <input type="text" id="verifyRollNo" name="roll_no" placeholder="Enter Your Roll Number" required>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%;">Verify Certificate</button>
                </form>

                <div id="verifyResult" style="margin-top: 24px;"></div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Get In Touch</h2>
                <p class="section-subtitle">Have questions? We're here to help you start your learning journey</p>
            </div>
            
            <div class="contact-content">
                <div class="contact-info">
                    <div class="info-card">
                        <h3>SoftSkill Computer Institute </h3>
                        <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <div>
                                <p>Dargah Road</p>
                                <p>Gopalganj, Bihar  - 841428</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="info-card">
                        <h3>Contact Information</h3>
                        <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <a href="mailto:Softskill">Softskill@gmail.com</a>
                        </div>
                        <!-- <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <a href="mailto:projects@bciindia.in">projects@bciindia.in</a>
                        </div> -->
                        <div class="info-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <a href="tel:+91 9852525294">+91 9852525294</a>
                        </div>
                    </div>
                    
                    <div class="info-card">
                        <h3>Quick Links</h3>
                        <ul class="quick-links">
                            <li><a href="#courses">Affiliations</a></li>
                            <li><a href="#courses">Courses</a></li>
                            <li><a href="#verify">Verify Certificate</a></li>
                            <li><a href="#contact">Contact Us</a></li>
                        </ul>
                    </div>
                </div>
                
                <div class="contact-form-container">
                    <form class="contact-form" id="contactForm">
                        <div class="form-group">
                            <input type="text" name="name" placeholder="Your Name" required>
                        </div>
                        <div class="form-group">
                            <input type="email" name="email" placeholder="Your Email" required>
                        </div>
                        <div class="form-group">
                            <input type="tel" name="phone" placeholder="Your Phone" required>
                        </div>
                        <div class="form-group">
                            <select name="course" required>
                                <option value="">Select Course</option>
                                <option value="dca">DCA</option>
                                <option value="adca">ADCA</option>
                                <option value="web">Web Designing</option>
                                <option value="python">Python</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <textarea name="message" placeholder="Your Message" rows="4"></textarea>
                        </div>
                        <div id="contactFormMsg"></div>
                        <button type="submit" class="btn btn-primary">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <img src="logo.png" alt="SoftSkill Institute">
                        <span>SoftSkill</span>
                    </div>
                    <p>Empowering the next generation of tech professionals</p>
                </div>
                
                <div class="footer-social">
                    <h4>Follow Us</h4>
                    <div class="social-links">
                        <a href="https://www.facebook.com/SoftskillComputer/photos/" class="social-icon facebook" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                        </a>
                        <a href="#" class="social-icon twitter" aria-label="Twitter">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                            </svg>
                        </a>
                        <a href="#" class="social-icon youtube" aria-label="YouTube">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>Copyright © 2016 SoftSkill. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="script.js"></script>
    <script src="main.js"></script>
</body>
</html>

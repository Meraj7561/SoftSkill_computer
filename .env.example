# Copy this file to .env for local development.
# On Vercel, set these same values under Project Settings -> Environment Variables instead.

# --- Database (use a remote/cloud MySQL - PlanetScale, Railway, Aiven, etc.) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=softskill_db
DB_USER=root
DB_PASS=

# --- Auth ---
# Any long random string. Used to sign the admin login JWT cookie.
JWT_SECRET=change_this_to_a_long_random_string

# --- WhatsApp ---
# Country code + number, no + sign, no spaces, e.g. 919852525294
WHATSAPP_NUMBER=919852525294
